{
  "name": "wichteln",
  "private": true,
  "version": "1.0.1",
  "description": "Mobile-first Secret Santa PWA with Cloudflare Worker and D1",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute wichtel-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.0.0"
  }
}